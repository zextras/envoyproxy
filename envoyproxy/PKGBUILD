# Envoy must be in the range accepted by the shipped Consul
# (service-discover-base), otherwise `consul connect envoy` refuses to start
# the sidecars. See envoyextensions/xdscommon/ENVOY_VERSIONS in
# hashicorp/consul and https://developer.hashicorp.com/consul/docs/connect/proxies/envoy
# Consul 2.1.x accepts Envoy 1.36 - 1.39; Renovate is capped accordingly in
# .github/renovate.json.

pkgname="envoyproxy"
pkgver="1.39.6" # renovate: datasource=github-releases depName=envoyproxy/envoy
pkgrel="1"
pkgdesc="A high performance, open source, general RPC framework that puts mobile and HTTP/2 first."
maintainer="Zextras SRL <packages@zextras.com>"
arch=('x86_64')
url="https://www.zextras.com"
license=("Apache-2.0")
section="utils"
provides=("getenvoy-envoy")
conflicts=(
  "getenvoy-envoy"
  "service-discover-base<2.1.0"
)
source=(
  "https://github.com/envoyproxy/envoy/releases/download/v${pkgver}/envoy-contrib-${pkgver}-linux-x86_64"
)
# ncurses-compat-libs: libtinfo.so.5, needed by Envoy's hermetic LLVM 18 clang
# glibc-devel: host headers for the luajit build tools (built without sysroot)
makedepends__rocky_8=(
  "git"
  "glibc-devel"
  "ncurses-compat-libs"
  "patch"
  'python39'
)
source__rocky_8=(
  "https://github.com/bazelbuild/bazelisk/releases/download/v1.30.0/bazelisk-linux-amd64"
  "https://github.com/envoyproxy/envoy/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=(
  '97dde58e22a463727f1a61a3044a584930c0655553d9e12cf25dac350226e798'
)
sha256sums__rocky_8=(
  'a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8'
  'f938453f950137b811a7119a21a606c81c6a4b0ef222fbac084a941c24bb3495'
)

package() {
  install -Dm755 ${srcdir}/envoy-contrib-${pkgver}-linux-x86_64 \
    "${pkgdir}/usr/bin/envoy"
}

# Upstream binaries need glibc >= 2.30 and el8 ships 2.28, so build from
# source. Envoy builds with a hermetic Clang toolchain and sysroot whose
# default glibc is 2.31: select the glibc 2.28 sysroot shipped by
# envoy_toolshed, otherwise the binary would not run on el8.
build__rocky_8() {
  cd "${srcdir}/envoy-${pkgver}"
  python3 tools/github/write_current_source_version.py
  sed -i 's/^envoy_dependencies_extra()$/envoy_dependencies_extra(glibc_version = "2.28")/' WORKSPACE
  grep -q '^envoy_dependencies_extra(glibc_version = "2.28")$' WORKSPACE
  chmod +x ../bazelisk-linux-amd64

  # Only compile the extensions Consul can configure on a sidecar: drop
  # protocol proxies, Lua, Wasm, dynamic modules, compression, extra
  # tracers and cloud-specific filters. Extensions Consul generates
  # (agent/xds) are kept, e.g. rbac, header_to_metadata, ext_authz,
  # jwt_authn, tcp_proxy, sni_cluster, connection_limit, tls/http
  # inspectors, original_dst, zipkin/opentelemetry, statsd sinks.
  mkdir -p "${srcdir}/envoy_build_config"
  touch "${srcdir}/envoy_build_config/WORKSPACE"
  echo 'exports_files(["extensions_build_config.bzl"])' \
    > "${srcdir}/envoy_build_config/BUILD"
  python3 - source/extensions/extensions_build_config.bzl \
    "${srcdir}/envoy_build_config/extensions_build_config.bzl" <<'EOF'
import re, sys
drop = re.compile(r'"envoy\.(' + '|'.join([
    r'[a-z_.]*wasm[a-z_.]*', r'[a-z_.]*lua[a-z_.]*', r'[a-z_.]*dynamic_module[a-z_]*',
    # Rust dynamic module, needs the dynamic_modules callbacks dropped above
    r'network\.dns_resolver\.hickory',
    r'compression\.', r'filters\.http\.(compressor|decompressor|gzip)',
    r'filters\.(dubbo|thrift)\.', r'generic_proxy\.',
    r'filters\.network\.(dubbo_proxy|thrift_proxy|redis_proxy|mongo_proxy|zookeeper_proxy|generic_proxy|sni_dynamic_forward_proxy|echo)',
    r'clusters\.redis', r'health_checkers\.(redis|thrift)',
    r'tracers\.(datadog|skywalking|xray|fluentd)',
    r'filters\.http\.(grpc_json_transcoder|grpc_json_reverse_transcoder|grpc_field_extraction|proto_message_extraction|geoip|oauth2|gcp_authn|aws_lambda|aws_request_signing|cache|file_system_buffer|ext_proc|rate_limit_quota|thrift_to_metadata)',
    r'geoip_providers\.', r'http\.cache\.', r'http\.ext_proc\.', r'transport_sockets\.alts',
    r'quic\.', r'udp_packet_writer\.gso',
]) + r')[a-z0-9_.]*"\s*:')
src, dst = sys.argv[1], sys.argv[2]
kept = dropped = 0
with open(src) as f, open(dst, "w") as out:
    for line in f:
        if drop.match(line.strip()):
            dropped += 1
            continue
        kept += line.strip().startswith('"envoy.')
        out.write(line)
print(f"envoy extensions: kept {kept}, dropped {dropped}")
if dropped < 50:
    sys.exit("extension trimming matched too little: check the deny-list")
EOF

  # Bazel reads the host core count, not the cgroup CPU quota, so it would
  # otherwise start one compile per host core inside a 4-CPU/10Gi container
  # and OOMKill it. Keep this in sync with the yap container cpu limit in
  # infra-k3s (argocd-projects/dev-zextras/jenkins/jcasc/kubernetes-cloud.yaml).
  # ~/.cache/bazel-ci is a persistent hostPath owned by the build user on
  # the CI rocky-8 agents (infra-k3s jenkins/jcasc/kubernetes-cloud.yaml):
  # keep Bazel's action and download caches there so rebuilds only compile
  # what changed. Elsewhere it is a plain directory.
  _cache="${HOME}/.cache/bazel-ci"
  ../bazelisk-linux-amd64 build --config=clang -c opt --jobs=4 \
    --disk_cache="${_cache}/disk" \
    --repository_cache="${_cache}/repo" \
    --experimental_disk_cache_gc_max_size=20G \
    --override_repository=envoy_build_config="${srcdir}/envoy_build_config" \
    --define=wasm=disabled \
    --@envoy//bazel:http3=False \
    //source/exe:envoy-static
}

package__rocky_8() {
  cd "${srcdir}/envoy-${pkgver}"
  install -Dm755 bazel-bin/source/exe/envoy-static \
    "${pkgdir}/usr/bin/envoy"
  strip "${pkgdir}/usr/bin/envoy"
}
